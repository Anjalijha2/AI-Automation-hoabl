{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["automation/pages/*"],
      "@utils/*": ["automation/utils/*"],
      "@fixtures/*": ["automation/fixtures/*"]
    }
  },
  "include": ["automation/**/*.ts", "ai-agent/**/*.ts"]
}
