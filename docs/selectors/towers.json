{
  "page": {
    "url": "/admin/towers",
    "title": "Tower View"
  },
  "kpi": {
    "towersCard": ".towers-card-content:not(.units-card-content)",
    "unitsCard": ".towers-card-content.units-card-content",
    "towerTotal": "li:has(h6:text('Total')) — inside towersCard",
    "towerActive": "li.active-status-tag — inside towersCard",
    "towerInactive": "li:not(.active-status-tag):has-text('Inactive') — inside towersCard",
    "unitTotal": "li:has(h6:text('Total')) — inside unitsCard",
    "unitSold": "li.sold-status-tag",
    "unitAvailable": "li.active-status-tag — inside unitsCard",
    "unitDisabled": "li.disabled-status-tag"
  },
  "towerList": {
    "towerItem": "li.tower-item",
    "selectedTower": "li.tower-item.selected-tower",
    "inactiveBadge": "(Inactive) text inside li.tower-item",
    "unitsAvailableText": "p inside li.tower-item — e.g. '155 Units Available'"
  },
  "grid": {
    "statsWrap": ".floors-index-wrap",
    "towerNameTitle": "h6.tower-name-title",
    "legendList": ".index-list-wrap",
    "legendSquare": ".sm-square",
    "legendSquareActive": ".sm-square.active",
    "legendSquareSold": ".sm-square.sold",
    "legendSquarePayingNow": ".sm-square.paying-now",
    "legendSquareRefuge": ".sm-square.refuge",
    "legendSquareDisabled": ".sm-square.disabled",
    "legendSquarePbt": ".sm-square.pbt",
    "floorNumbers": ".floor-number",
    "unitSectionBox": ".unit-section-box",
    "unitSizeItem": ".unit-size-item",
    "unitAvailable": ".unit-size-item.available",
    "unitBooked": ".unit-size-item.booked",
    "unitReserved": ".unit-size-item.reserved",
    "unitDisabled": ".unit-size-item.disabled-unit",
    "unitRefuge": ".unit-size-item.refuge",
    "unitPbt": ".unit-size-item.pbt",
    "unitSizeHeader": ".unit-size-item — first 8 are header descriptors, rest are unit numbers"
  },
  "drawer": {
    "drawerContent": ".allocation-details-drawer-content",
    "drawerContentVisible": ".allocation-details-drawer-content:not(.visibility-hidden)",
    "moreDetails": ".more-details-allocation",
    "allocationItemList": ".allocation-item-list",
    "allocationItemTwo": ".allocation-item-two",
    "itemLabel": ".item-label",
    "inclusivePrice": ".increase-price-wrap p"
  },
  "notes": {
    "unitNumbers": "Unit numbers (e.g. 3501) are text inside .unit-size-item. First ~8 items are column headers (unit type descriptors), not unit numbers.",
    "inactiveToursAvailable": "Inactive towers still show unit-count but show (Inactive) badge",
    "drawerHiddenClass": "Drawer has .visibility-hidden class when no unit selected",
    "agreementValue": "Agreement Value shown in .allocation-item-two",
    "inclusivePriceLabel": "All inclusive price shown in .increase-price-wrap"
  }
}
