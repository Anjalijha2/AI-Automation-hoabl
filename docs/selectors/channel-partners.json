{
  "page": "/admin/channel-partners",
  "description": "Channel Partners module — selector reference",

  "header": {
    "title": "h3.table-title",
    "totalCountPattern": "/(\\d[\\d,]*)\\s*Channel Partners/i",
    "mapMasterCPButton": "button:has-text('Map Master CP')",
    "resetFiltersButton": "button:has-text('Reset Filters')",
    "refreshButton": "button:has-text('Refresh')"
  },

  "search": {
    "phoneInput": "input[placeholder*='Phone' i]"
  },

  "table": {
    "columnHeaders": "thead th",
    "bodyRows": "tbody tr",
    "dataRowByPhone": "tbody tr:has-text('{phone}')",
    "checkboxFirstRow": "tbody tr:nth-child(2) .ant-checkbox-input, tbody tr:nth-child(2) input[type=checkbox]"
  },

  "actions": {
    "viewButton": "button.cp-row-action:nth-of-type(1)",
    "moreButton": "button.cp-row-action:nth-of-type(2)",
    "dropdownMenuItems": ".ant-dropdown-menu-item:visible, [role=menuitem]:visible"
  },

  "viewDrawer": {
    "container": ".ant-drawer-body",
    "title": ".ant-drawer-title",
    "closeButton": ".ant-drawer-close, button[aria-label='Close']",
    "sections": {
      "basicInformation": "Basic Information",
      "firmDetails": "Firm Details",
      "contactDetails": "Contact Details",
      "additionalDetails": "Additional Details"
    }
  },

  "mapMasterModal": {
    "container": ".ant-modal-body",
    "title": ".ant-modal-title",
    "masterHVDropdown": ".ant-select",
    "cancelButton": ".ant-modal button:has-text('Cancel'), .ant-modal-close"
  },

  "notes": [
    "Title always shows full count (2705) — phone search filters rows, not the header count",
    "Actions column has two buttons per row: index 0 = eye (view), index 1 = more (…)",
    "Map Master CP button uses Ant Design disabled state (.ant-btn-disabled or disabled attribute)",
    "Dropdown menu picks up nav items too — filter for 'Mark as Master' specifically"
  ]
}
