{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@base/*":      ["automation-repository/base/*"],
      "@pages/*":     ["automation-repository/pages/*"],
      "@utils/*":     ["automation-repository/utils/*"],
      "@fixtures/*":  ["automation-repository/fixtures/*"],
      "@constants/*": ["automation-repository/constants/*"],
      "@agents/*":    ["automation-repository/agents/*"]
    },
    "checkJs": false
  },
  "include": ["automation-repository/**/*.js", "tests/**/*.js", "config/**/*.js"],
  "exclude": ["node_modules", "test-results", "reports"]
}
