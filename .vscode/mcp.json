{
    "servers": {
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "playwright-vision": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--vision"
            ]
        },
        "playwright-headless": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest",
                "--headless"
            ]
        }
    }
}