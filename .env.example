# XR Portal QA Framework — environment template
# Copy to .env and fill in real values. .env is gitignored.

# ─── Database (UAT, read-only) ───────────────────────────────────────────────
# Strapi DB (portal_strapi_uat) is EXCLUDED per project constraint — never set.
DB_HOST=20.244.46.36
DB_PORT=3306
DB_NAME=portal_node_uat
DB_USER=readonly_uat_user
DB_PASSWORD=
DB_DIALECT=mysql

# ─── Test execution flags ────────────────────────────────────────────────────
# ENV=uat skips tests guarded with test.skip(process.env.ENV === 'uat', ...)
ENV=uat

# ─── SMTP — Execution Report email dispatch ──────────────────────────────────
# Used by scripts/send-execution-report.js (npm run report:email).
# Outlook 365 example below; replace with your provider.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=qa-bot@yourtenant.onmicrosoft.com
SMTP_PASS=
SMTP_FROM=qa-bot@yourtenant.onmicrosoft.com
# Set SMTP_SECURE=true for port 465 (implicit TLS). 587 uses STARTTLS by default.
SMTP_SECURE=false
# Local dev SMTP (mailpit/maildev):
#   SMTP_HOST=localhost SMTP_PORT=1025 SMTP_IGNORE_TLS=true (no auth)
SMTP_IGNORE_TLS=false
# Override the recipient (defaults to anjali.jha@openspaceservices.com)
# REPORT_TO=anjali.jha@openspaceservices.com
