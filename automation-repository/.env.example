# Per-environment config — copy to .env and fill in values
# .env is git-ignored

# Portal URL
BASE_URL=https://uat-web.xrportal.in/admin

# API base (if different from portal URL)
# API_BASE_URL=https://uat-api.xrportal.in

# Run mode
# HEADLESS=true     # set in CI

# Environment tag (used in skip guards)
# ENV=uat
