{
  "name": "xrportal-qa-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "discover": "node src/discovery/config-discovery.js",
    "docs:generate": "node src/agents/page-doc-agent.js",
    "testcases:generate": "node src/agents/testcase-agent.js",
    "automation:generate": "node src/agents/automation-agent.js",
    "execute": "node src/agents/execution-agent.js",
    "execute:login": "node src/agents/execution-agent.js login",
    "execute:customers": "node src/agents/execution-agent.js customers",
    "defects:log": "node src/agents/defect-agent.js",
    "heal:analyze": "node src/agents/healing-agent.js",
    "sprint:status": "node src/agents/sprint-manager.js status",
    "sprint:update": "node src/agents/sprint-manager.js update",
    "sprint:plan-brd": "node src/agents/sprint-manager.js plan-brd",
    "test": "npx playwright test --config config/playwright.config.js --project=regression --workers=1",
    "test:chrome": "npx playwright test --config config/playwright.config.js --project=chromium --workers=1",
    "test:firefox": "npx playwright test --config config/playwright.config.js --project=firefox --workers=1",
    "test:webkit": "npx playwright test --config config/playwright.config.js --project=webkit --workers=1",
    "test:all": "npx playwright test --config config/playwright.config.js --workers=1",
    "test:headed": "npx playwright test --config config/playwright.config.js --project=regression --headed --workers=1",
    "test:smoke": "npx playwright test --config config/playwright.config.js --project=smoke --headed --workers=1",
    "test:login": "npx playwright test --config config/playwright.config.js tests/ui/login.spec.js --project=login-tests --headed --workers=1",
    "test:login:positive": "npx playwright test --config config/playwright.config.js tests/ui/login.spec.js --project=login-tests --headed --workers=1 -g \"POSITIVE\"",
    "test:login:negative": "npx playwright test --config config/playwright.config.js tests/ui/login.spec.js --project=login-tests --headed --workers=1 -g \"NEGATIVE\"",
    "test:customers": "npx playwright test --config config/playwright.config.js tests/ui/customers.spec.js --project=regression --headed --workers=1",
    "test:offers": "npx playwright test --config config/playwright.config.js tests/ui/offers.spec.js --project=regression --workers=1",
    "test:regression": "npx playwright test --config config/playwright.config.js --project=regression --headed --workers=1",
    "test:report": "npx playwright show-report reports/html-report",
    "report": "npx playwright show-report reports/html-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "xlsx": "^0.18.5"
  }
}
