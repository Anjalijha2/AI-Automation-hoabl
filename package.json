{
  "name": "xrportal-qa-framework",
  "version": "2.0.0",
  "description": "XR Portal QA Framework — Sprint-wise, Portal-wise execution",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --config config/playwright.config.js --project=regression --workers=1",
    "test:headed": "npx playwright test --config config/playwright.config.js --project=regression --headed --workers=1",
    "test:smoke": "npx playwright test --config config/playwright.config.js --project=smoke --headed --workers=1",
    "test:login": "npx playwright test --config config/playwright.config.js tests/e2e/login.spec.js --project=login-tests --headed --workers=1",
    "test:regression": "npx playwright test --config config/playwright.config.js --project=regression --headed --workers=1",
    "test:chrome": "npx playwright test --config config/playwright.config.js --project=chromium --workers=1",
    "test:firefox": "npx playwright test --config config/playwright.config.js --project=firefox --workers=1",
    "test:webkit": "npx playwright test --config config/playwright.config.js --project=webkit --workers=1",
    "test:all": "npx playwright test --config config/playwright.config.js --workers=1",
    "auth:setup": "npx playwright test --config config/playwright.config.js --project=auth-setup",
    "report": "npx playwright show-report reports/html-report",
    "discover": "node automation-repository/discovery/config-discovery.js",
    "docs:generate": "node automation-repository/agents/page-doc-agent.js",
    "testcases:generate": "node automation-repository/agents/testcase-agent.js",
    "automation:generate": "node automation-repository/agents/automation-agent.js",
    "execute": "node automation-repository/agents/execution-agent.js",
    "defects:log": "node automation-repository/agents/defect-agent.js",
    "heal:analyze": "node automation-repository/agents/healing-agent.js",
    "sprint:status": "node automation-repository/agents/sprint-manager.js status",
    "sprint:update": "node automation-repository/agents/sprint-manager.js update"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.3.1",
    "playwright": "^1.58.2",
    "xlsx": "^0.18.5"
  }
}
