    },
    "verifyOtpBtn": {
      "selector": "button:has-text('Verify OTP')",
      "type": "css",
      "fallback": "button[type='submit']",
      "aria_role": "button",
      "deprecated": false,
      "changelog": ["1.0.0 — initial"]
